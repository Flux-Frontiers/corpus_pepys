# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class
*.so

# Distribution / packaging
build/
dist/
wheels/
*.egg-info/
*.egg

# Test / coverage
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.cache

# Type checkers / linters
.mypy_cache/
.ruff_cache/

# Environments
.env
.envrc
.venv
venv/
env/

# Local install-specific config (not portable)
.mcp.json

# Logs
*.log

