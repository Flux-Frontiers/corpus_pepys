# corpus_pepys — standalone KGRAG image for the Samuel Pepys DiaryKG
#
# Extends the kgrag-worker base image with:
#   - the pre-built Pepys .diarykg/ index baked in at /workspace/pepys/
#   - a Pepys-specific handler that registers the diary corpus
#
# Build workflow:
#   1. make build-index     — run diarykg build to produce .diarykg/ locally
#   2. make build-image     — docker build (COPYs .diarykg/ into image)
#   3. make run             — docker compose up
#
# The pre-built .diarykg/ must exist at the repo root before building.

FROM egsuchanek/kgrag-worker:latest

WORKDIR /app

# Install diary-kg from PyPI (provides DiaryKG, doc-kg, and diarykg CLI).
# watchdog: faster Streamlit file-watching via native OS events (vs. polling).
RUN pip install --no-cache-dir diary-kg watchdog streamlit httpx openai uvicorn

# Pre-download the embedding model during build so the container never needs
# to reach HuggingFace at runtime (network may be unavailable or restricted).
ARG EMBED_MODEL=BAAI/bge-small-en-v1.5
RUN python - <<'EOF'
import os
from sentence_transformers import SentenceTransformer
model = os.environ.get("EMBED_MODEL", "BAAI/bge-small-en-v1.5")
print(f"Pre-downloading {model} ...")
SentenceTransformer(model)
print("Done.")
EOF

# Force offline mode — no HF network calls at runtime.
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1

# Bake the Pepys DiaryKG index into the image.
# .diarykg/ is generated by 'make build-index' and gitignored.
COPY .diarykg/ /workspace/pepys/.diarykg/

# Pepys-specific handler (replaces the upstream gutenberg/metabo handler)
COPY docker/handler.py   /app/handler.py
COPY docker/chat.py      /app/chat.py
COPY docker/image_gen.py /app/image_gen.py

ENV PEPYS_KG_ROOT=/workspace/pepys
ENV EMBED_MODEL=BAAI/bge-small-en-v1.5

CMD ["python", "-u", "handler.py"]
