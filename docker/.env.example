# Copy to docker/.env and fill in as needed.
# All variables are optional — defaults work for a pure local setup.
# Synthesis is OFF unless VLLM_ENDPOINT_URL points at a running LLM server.

# Optional: require callers to include {"secret": "<value>"} in every request
HANDLER_SECRET=

# ---------------------------------------------------------------------------
# Synthesis backend — any OpenAI-compatible /v1 endpoint works.
# Leave all of this alone to run search-only; synthesis is optional.
# ---------------------------------------------------------------------------
# The endpoint the worker uses by default. The values shipped here target oMLX,
# which is Apple-Silicon only — see the two blocks below and use whichever fits
# your machine. Whatever you point at, keep the /v1 suffix: the worker speaks
# the OpenAI wire protocol, and without /v1 synthesis 404s while plain search
# keeps working, which looks like a broken feature rather than a bad URL.
#
# CROSS-PLATFORM (Linux/macOS/Windows) — Ollama (https://ollama.com), no API key:
#
#     ollama pull qwen3:4b
#     VLLM_ENDPOINT_URL=http://host.docker.internal:11434/v1
#     VLLM_MODEL=qwen3:4b
#     VLLM_API_KEY=
#
# APPLE SILICON — oMLX (https://omlx.ai), faster, multi-model. Start it on 8080
# (8000 is taken by the worker):
#
#     make serve-llm
#
# VLLM_API_KEY must then be your oMLX API key (~/.omlx/settings.json → auth.api_key).
VLLM_ENDPOINT_URL=http://host.docker.internal:8080/v1
VLLM_MODEL=Qwen3-30B-A3B-Instruct-2507-MLX-4bit
VLLM_API_KEY=sk-your-omlx-api-key

# ---------------------------------------------------------------------------
# Ollama backend (https://ollama.com) — cross-platform, no API key needed.
# Used when the chat UI's Provider dropdown is set to Ollama, independently of
# VLLM_ENDPOINT_URL above.
OLLAMA_ENDPOINT=http://host.docker.internal:11434/v1

# ---------------------------------------------------------------------------
# OpenAI backend — required if you select OpenAI in the Provider dropdown.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Image generation (optional — the chat UI's "Render response" button).
# Served by `make image-server` on the HOST, which needs Apple MLX (macOS arm64)
# or mlx[cuda13] on a Linux box with an NVIDIA GPU. `make up` skips it with a
# note on hosts that cannot run it; everything else is unaffected.
# Point IMAGE_ENDPOINT at any OpenAI-compatible image server to use another one.
# ---------------------------------------------------------------------------
IMAGE_ENDPOINT=http://host.docker.internal:8090
IMAGE_STEPS=4
