# Copy to docker/.env and fill in as needed.
# All variables are optional — defaults work for a pure local setup.

# Optional: require callers to include {"secret": "<value>"} in every request
HANDLER_SECRET=

# Synthesis via local Ollama (leave blank to disable synthesis entirely)
VLLM_ENDPOINT_URL=http://host.docker.internal:11434
VLLM_MODEL=qwen3:4b
RUNPOD_API_KEY=ollama
